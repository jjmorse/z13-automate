[Unit]
Description=Pause Onboard auto-show while the keyboard folio is attached
After=z13-onboard.service
Wants=z13-onboard.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/z13-onboard-follow
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
