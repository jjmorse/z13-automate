[Unit]
Description=Fn lock for the ASUS ROG Flow Z13 folio keyboard
After=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/bin/z13-fnlock daemon --default off
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
