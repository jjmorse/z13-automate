[Unit]
Description=Restore the saved monitor layout after dock or resume events
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 -I %h/.local/bin/z13-display-restore watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
